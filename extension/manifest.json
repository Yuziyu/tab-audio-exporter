{
  "manifest_version": 3,
  "name": "Tab Audio Exporter (PoC)",
  "version": "0.0.1",
  "description": "タブで鳴っている音を MP3 (192kbps) として書き出す個人用PoC",
  "minimum_chrome_version": "116",
  "permissions": ["tabCapture", "offscreen", "sidePanel", "activeTab", "tabs", "downloads"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "action": { "default_title": "Tab Audio Exporter" },
  "side_panel": { "default_path": "sidepanel.html" },
  "commands": {
    "toggle-recording": {
      "suggested_key": { "default": "Alt+Shift+R", "mac": "Alt+Shift+R" },
      "description": "録音の開始/停止（アクティブなタブ）"
    }
  }
}
