{
  "name": "tab-audio-exporter",
  "version": "0.0.1",
  "private": true,
  "description": "Record a Chrome tab's audio and export it as MP3 (web app and Chrome extension)",
  "type": "module",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "test": "node --test test/unit/*.test.js",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=.browsers node --test --test-concurrency=1 test/e2e/*.test.js",
    "soak": "SOAK_SECONDS=${SOAK_SECONDS:-600} npm run test:e2e",
    "setup:browsers": "PLAYWRIGHT_BROWSERS_PATH=.browsers playwright-core install chromium",
    "web": "node web/server.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7"
  },
  "devDependencies": {
    "playwright-core": "^1.0.0"
  }
}
